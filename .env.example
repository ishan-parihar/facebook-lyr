[TEMPLATE]
# Facebook MCP Server — environment template
# Copy to .env and fill in (or export in your shell).

# Cookie-based session for headless agents (required for all tools).
# A JSON object with at least c_user (numeric user id) and xs (session secret)
# from a logged-in facebook.com browser session:
#   FACEBOOK_COOKIES='{"c_user":"12345","xs":"abc...","fr":"...","datr":"..."}'
FACEBOOK_COOKIES=

# Browser to auto-import cookies from (interactive --login; optional)
# FACEBOOK_PREFERRED_BROWSER=chrome

# Profile directory (default ~/.facebook-lyr/profile)
# USER_DATA_DIR=~/.facebook-lyr/profile

# Server settings
LOG_LEVEL=WARNING
TRANSPORT=stdio
# HOST=127.0.0.1
# PORT=8000
# HTTP_PATH=/mcp
